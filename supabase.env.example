# Supabase readiness placeholders.
# Leave all secret values blank until the target project credentials are supplied.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Start with SQLite mode; enable only after Supabase migration validation.
USE_SUPABASE=false

# Current code reads STORAGE_BUCKET_NAME. SUPABASE_DOCUMENT_BUCKET is retained
# as the requested deployment alias and is not read by the current implementation.
STORAGE_BUCKET_NAME=kulima-documents
SUPABASE_DOCUMENT_BUCKET=
