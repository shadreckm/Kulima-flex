## Kulima FLEX — Environment Configuration Template
## Copy this file to .env and fill in your actual keys.
## Never commit .env to version control.

# Required for live AI features; leave blank in templates.
OPENAI_API_KEY=

# Required for live Tavily research; leave blank in templates.
TAVILY_API_KEY=

# Model configuration (optional — defaults shown below)
# Recommended: gpt-4.1-mini for cost efficiency, gpt-4o for maximum depth
OPENAI_MODEL=gpt-4.1-mini
SYNDICATE_MODEL=gpt-4.1-mini
FUTURES_MODEL=gpt-4.1-mini

# Database path (optional — defaults to founders.db in project root)
# KULIMA_DB_PATH=founders.db

# OSINT research depth (optional — higher values = more sources = higher cost + latency)
# MAX_RESEARCH_RESULTS=8

# Access control (optional — options: pilot, guest, open)
# KULIMA_ACCESS_MODE=pilot
# KULIMA_GUEST_DAILY_LIMIT=3
# KULIMA_ANALYST_DAILY_LIMIT=25
# KULIMA_INVESTOR_DAILY_LIMIT=10

# Admin email list (optional — comma-separated)
# KULIMA_ADMIN_EMAILS=admin@yourfund.com
