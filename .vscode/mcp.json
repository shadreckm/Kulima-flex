{
  "mcpServers": {
    "tavily-remote-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.tavily.com/mcp/?tavilyApiKey=${env:TAVILY_API_KEY}"
      ],
      "env": {
        "DEFAULT_PARAMETERS": "{\"search_depth\":\"advanced\",\"max_results\":10}"
      }
    }
  }
}
