# Frontend environment configuration for Kulima OS Web (Next.js)
# Copy this file to `frontend/.env.local`.

# === NextAuth core ===
# Public URL where the frontend is served (used for callback URLs).
NEXTAUTH_URL="http://localhost:3001"

# Must match NEXTAUTH_SECRET used by the backend JWT validator.
NEXTAUTH_SECRET="replace-with-long-random-string"

# === Google OAuth provider ===
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# === Azure AD / Microsoft provider ===
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# === Backend API base URL exposed to the frontend ===
# Local dev:
NEXT_PUBLIC_API_URL="http://localhost:8000"

# For Vercel + managed backend, set to your deployed FastAPI URL, e.g.:
# NEXT_PUBLIC_API_URL="https://api.kulima-os.your-domain.com"
