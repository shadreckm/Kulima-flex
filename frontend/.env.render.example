# Render frontend service: native Node web service rooted at frontend/.
# Secrets stay blank here. NEXTAUTH_SECRET is injected from the shared
# kulima-auth Render environment group; KULIMA_BACKEND_HOSTPORT is a Blueprint
# reference to the private kulima-os-api service.
NODE_VERSION=20.19.0
NEXTAUTH_URL=
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
KULIMA_BACKEND_HOSTPORT=
# Optional absolute backend URL override; prefer the private hostport above.
KULIMA_BACKEND_URL=
# Legacy/local fallback only. Keep blank on Render when using the private hostport.
NEXT_PUBLIC_API_URL=