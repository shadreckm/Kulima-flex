# Render backend environment template. Set actual values in Render, not Git.
ENVIRONMENT=production
NEXTAUTH_SECRET=your-nextauth-secret
OPENAI_API_KEY=your-openai-api-key
TAVILY_API_KEY=your-tavily-api-key
ALLOWED_ORIGINS=https://your-vercel-domain.vercel.app
KULIMA_DB_PATH=/data/kulima.db
OPENAI_MODEL=gpt-4.1-mini
FUTURES_MODEL=gpt-4.1-mini
SYNDICATE_MODEL=gpt-4.1-mini
KULIMA_RATE_LIMIT_REQUESTS=60
KULIMA_RATE_LIMIT_WINDOW_SECONDS=60

# === Enterprise Trust & Monetization ===
# Billing enforcement off during pilots: quotas visible but not blocking.
KULIMA_BILLING_ENFORCEMENT=false
KULIMA_BILLING_DEMO_MODE=false
KULIMA_GRACE_PERIOD_DAYS=7
KULIMA_PLAN_CURRENCY=USD
# Optional pricing overrides (JSON), e.g. {"pro": {"monthlyPrice": 49}, "enterprise": {"monthlyPrice": 299}}
KULIMA_PLAN_PRICING_JSON=

# PayChangu live payments (leave blank to run checkout in demo mode)
PAYCHANGU_SECRET_KEY=
PAYCHANGU_WEBHOOK_SECRET=
PAYCHANGU_CURRENCY=USD
PAYCHANGU_API_BASE=

# Document security: any passphrase enables AES-256-GCM at-rest encryption
# (SHA-256 derived into a 32-byte key). Requires the `cryptography` package,
# which is installed by the Dockerfile from backend/requirements.txt.
KULIMA_DOC_ENCRYPTION_KEY=
# Default retention window for uploaded documents in days (0 = keep until deleted)
KULIMA_DEFAULT_RETENTION_DAYS=0
