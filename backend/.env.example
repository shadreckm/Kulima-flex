# Backend environment configuration for Kulima FLEX.
# Copy to backend/.env and replace blank secret values in the target environment.

# === Runtime / deployment ===
ENVIRONMENT="development"
# Production requires a non-empty comma-separated allowlist.
ALLOWED_ORIGINS=""
# Render/Docker use /data/kulima.db; the code fallback is founders.db.
KULIMA_DB_PATH="/data/kulima.db"
# Test/SSE helper only.
KULIMA_API_URL="http://localhost:8000"
# Never enable outside an isolated test environment.
KULIMA_SKIP_AUTH="false"

# === Authentication ===
# Shared with the Vercel frontend; leave blank in templates.
NEXTAUTH_SECRET=""

# === OpenAI (Tier 1 provider) ===
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
SYNDICATE_MODEL="gpt-4.1-mini"
FUTURES_MODEL="gpt-4.1-mini"

# === Groq (Tier 2 provider — failover from OpenAI) ===
# Get your key at https://console.groq.com
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_REASONING_MODEL="openai/gpt-oss-120b"
# Comma-separated preferred model aliases (configurable)
GROQ_PREFERRED_MODELS="gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b"

# === Google Gemini (Tier 3 provider — between Groq and OpenRouter) ===
# Get your key at https://aistudio.google.com/apikey
# Uses the official OpenAI-compatible endpoint (generativelanguage.googleapis.com).
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-pro"
# Falls back to gemini-2.5-flash automatically on failover / lightweight tasks.

# === OpenRouter (Tier 4 provider — emergency provider) ===
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/auto"
OPENROUTER_FREE_MODEL="openrouter/auto"

# === HuggingFace (Tier 5 provider — classification, extraction, summarization) ===
# Get your key at https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=""
HUGGINGFACE_MODEL="meta-llama/Llama-3.1-8B-Instruct"
HUGGINGFACE_BASE_URL="https://router.huggingface.co/v1"

# === Provider chain (Tier 5 = Document Intelligence Mode — always available) ===
# Comma-separated order; remove a provider name to exclude it from the chain
KULIMA_PROVIDER_ORDER="openai,groq,gemini,openrouter,huggingface"
# Per-provider LLM call timeout in seconds
KULIMA_LLM_TIMEOUT="45"


# === Tavily ===
TAVILY_API_KEY=""
MAX_RESEARCH_RESULTS="8"
AFRICA_FOCUS="true"

# === Supabase / database readiness ===
# SUPABASE_KEY is the anon/public key currently read by storage_service.py.
SUPABASE_URL=""
SUPABASE_KEY=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
DATABASE_URL=""
USE_SUPABASE="false"
STORAGE_BUCKET_NAME="kulima-documents"
# Requested readiness alias; current code reads STORAGE_BUCKET_NAME.
SUPABASE_DOCUMENT_BUCKET=""

# === Rate limiting ===
KULIMA_RATE_LIMIT_REQUESTS="60"
KULIMA_RATE_LIMIT_WINDOW_SECONDS="60"

# === Billing / subscriptions ===
KULIMA_BILLING_ENFORCEMENT="false"
KULIMA_BILLING_DEMO_MODE="false"
KULIMA_GRACE_PERIOD_DAYS="7"
KULIMA_PLAN_CURRENCY="USD"
KULIMA_PLAN_PRICING_JSON=""
# Activate the plan when the customer lands back from a PayChangu hosted link
# (no API secret configured). Webhook stays authoritative when configured.
KULIMA_BILLING_LINK_AUTOCONFIRM="true"

# === PayChangu ===
PAYCHANGU_SECRET_KEY=""
PAYCHANGU_WEBHOOK_SECRET=""
PAYCHANGU_CURRENCY="USD"
PAYCHANGU_API_BASE="https://api.paychangu.com"
# Hosted payment links (checkout redirect targets)
PAYCHANGU_LINK_PRO="https://pay.paychangu.com/SC-GDDYA0"
PAYCHANGU_LINK_ENTERPRISE="https://pay.paychangu.com/SC-MBXJF6"

# === Document security / governance ===
KULIMA_DOC_ENCRYPTION_KEY=""
KULIMA_DEFAULT_RETENTION_DAYS="0"

# === Enterprise OS access control ===
KULIMA_ACCESS_MODE="pilot"
KULIMA_GUEST_DAILY_LIMIT="3"
KULIMA_ANALYST_DAILY_LIMIT="25"
KULIMA_INVESTOR_DAILY_LIMIT="10"
# Organization admins (Owner/Admin on a workspace). NOT a platform role: these
# identities are break-glass for the console only, and never grant cross-workspace
# visibility by themselves. Prefer the stored PLATFORM_ADMIN role below.
KULIMA_ADMIN_EMAILS=""

# === Platform administrator (PLATFORM_ADMIN — the /admin console) ===
# PLATFORM_ADMIN is a stored principal in the 'platform_admins' table, a plane
# entirely separate from the organization roles (Owner / Admin / Reviewer /
# Contributor / Viewer). Listed emails are provisioned into that role at startup;
# they are the only accounts that may read or mutate the admin API — everyone
# else receives 403 Forbidden.
KULIMA_PLATFORM_ADMIN_PRIMARY_EMAIL="kulimaafrica@gmail.com"
KULIMA_PLATFORM_ADMIN_EMAILS="kulimaafrica@gmail.com"
# Optional: bootstrap by stable JWT subject id instead of email (comma-separated).
KULIMA_PLATFORM_ADMIN_USER_IDS=""

# === Collection channels: Google Forms / Sheets (Forms Integration V1) ===
# Switched OFF by default, and a channel is an INGRESS — not a new pipeline.
# Each synced response window becomes one ordinary evidence document on the
# existing Assessment Context (documents and forms coexist; no new assessment
# type). Leave this block unset until a Google Cloud project exists.
KULIMA_FORMS_ENABLED=false
# OAuth client from a project with the Forms API and Google Sheets API enabled.
# Authorised redirect URI must be exactly <backend-origin>/api/v1/forms/oauth/callback.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
# Optional override; when unset the connector derives the callback from the request origin.
GOOGLE_OAUTH_REDIRECT_URI=""
# Optional: override the read-only scopes (comma-separated). Defaults to form body,
# form responses and spreadsheet READONLY scopes only.
GOOGLE_OAUTH_SCOPES=""
# Frontend origin the browser lands on after Google consent (e.g. https://kulima.app).
KULIMA_FORMS_RETURN_URL=""
# HMAC key for the OAuth state token. Falls back to KULIMA_DOC_ENCRYPTION_KEY, then
# to a per-process secret (which makes a restart invalidate in-flight consent).
KULIMA_FORMS_STATE_SECRET=""
# Credentials are sealed with KULIMA_DOC_ENCRYPTION_KEY. Without that key the
# connector REFUSES to store a token: the connection stays pending_auth with a
# visible error rather than keeping a plaintext secret.
# Batch sizing, transport bounds, scheduling.
KULIMA_FORMS_MIN_BATCH_SIZE="5"
KULIMA_FORMS_MAX_RESPONSES="500"
KULIMA_FORMS_MAX_PAGES="10"
KULIMA_FORMS_HTTP_TIMEOUT="30"
KULIMA_FORMS_POLL_MINUTES="0"
KULIMA_FORMS_USE_JOBS="false"
# Re-run the decision pipeline when a batch attaches. Unset = true; an explicitly
# EMPTY value means false. Follow-up (outcome) connections never re-run regardless.
KULIMA_FORMS_AUTO_RERUN="true"
# Self-reported ceilings. 70 mirrors the "structured data export" rung and 79 sits
# strictly below the VERIFIED threshold (80) — do not raise them without re-opening
# the Trust Engine design.
KULIMA_FORMS_SOURCE_CEILING="70"
KULIMA_FORMS_TRUST_CEILING="79"
