# Backend environment configuration for Kulima OS Web (closed beta)
# Copy this file to `backend/.env` and fill in the values for your environment.

ENVIRONMENT="development"

# === Core secrets ===
# Shared secret with NextAuth for signing/verifying JWTs.
NEXTAUTH_SECRET="your-nextauth-secret"

# OpenAI API key used by IntelligenceOrchestrator and other engines.
OPENAI_API_KEY="your-openai-api-key"

# Optional: Tavily API key for the research engine.
TAVILY_API_KEY="your-tavily-api-key"

# === Database ===
# Path to the SQLite database file inside the backend container or host.
# This is read by kulima.config.get_settings() as db_path.
KULIMA_DB_PATH="/data/kulima.db"

# === CORS / frontend origins ===
# Comma-separated list of allowed frontend origins.
# Example for local dev and Vercel preview:
ALLOWED_ORIGINS="http://localhost:3000,https://your-vercel-app.vercel.app"

# === LLM model selection ===
# Default OpenAI chat model for the LLM client.
OPENAI_MODEL="gpt-4.1-mini"
KULIMA_RATE_LIMIT_REQUESTS="60"
KULIMA_RATE_LIMIT_WINDOW_SECONDS="60"

# === Billing / subscriptions (Phases 7-8) ===
# When false (default) quotas are displayed but not enforced — safe for pilots.
KULIMA_BILLING_ENFORCEMENT="false"
# Demo mode simulates successful PayChangu checkouts when no keys are set.
KULIMA_BILLING_DEMO_MODE="false"
# Grace period (days) after a failed payment before new assessments pause.
KULIMA_GRACE_PERIOD_DAYS="7"
# Plan catalogue currency and optional pricing overrides (JSON).
KULIMA_PLAN_CURRENCY="USD"
# Example: {"pro": {"monthlyPrice": 49}, "enterprise": {"monthlyPrice": 299}}
KULIMA_PLAN_PRICING_JSON=""

# === PayChangu (leave blank to run without live payments) ===
PAYCHANGU_SECRET_KEY=""
PAYCHANGU_WEBHOOK_SECRET=""
PAYCHANGU_CURRENCY="USD"
PAYCHANGU_API_BASE=""

# === Document security (Phase 5) ===
# Any passphrase enables AES-256-GCM encryption for uploaded documents
# (the passphrase is SHA-256 derived into a 32-byte key). Without it,
# storage metadata records provider disk-level at-rest encryption instead.
KULIMA_DOC_ENCRYPTION_KEY=""
# Default retention window for uploaded documents in days (0 = keep until deleted).
KULIMA_DEFAULT_RETENTION_DAYS="0"

