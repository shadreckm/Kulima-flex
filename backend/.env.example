# Backend environment configuration for Kulima OS Web (closed beta)
# Copy this file to `backend/.env` and fill in the values for your environment.

ENVIRONMENT="development"

# === Core secrets ===
# Shared secret with NextAuth for signing/verifying JWTs.
NEXTAUTH_SECRET="your-nextauth-secret"

# OpenAI API key used by IntelligenceOrchestrator and other engines.
OPENAI_API_KEY="your-openai-api-key"

# Optional: Tavily API key for the research engine.
TAVILY_API_KEY="your-tavily-api-key"

# === Database ===
# Path to the SQLite database file inside the backend container or host.
# This is read by kulima.config.get_settings() as db_path.
KULIMA_DB_PATH="/data/kulima.db"

# === CORS / frontend origins ===
# Comma-separated list of allowed frontend origins.
# Example for local dev and Vercel preview:
ALLOWED_ORIGINS="http://localhost:3000,https://your-vercel-app.vercel.app"

# === LLM model selection ===
# Default OpenAI chat model for the LLM client.
OPENAI_MODEL="gpt-4.1-mini"
KULIMA_RATE_LIMIT_REQUESTS="60"
KULIMA_RATE_LIMIT_WINDOW_SECONDS="60"
